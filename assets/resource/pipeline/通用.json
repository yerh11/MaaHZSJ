{
    // ============ 全局通用 UI ============
    // 右上角设置（齿轮）：游戏内退出入口，用户确认的退出方式。
    //
    // 2026-10-02 修正一条旧话：从前这里写着「齿轮只出现在「卡牌菜单」面板里」——
    // **不对**。右上角那一排图标是**按屏变的**：地图屏上是「齿轮 + 人形十字」，
    // 事件屏/祭坛屏上是「卷轴 + 人形十字」（同一张地图帧上两个模板同时命中，
    // `设置` 0.7389 @ (1090,22,52x50)、`卡牌菜单` 0.9153 @ (1180,25,56x56)，
    // 现场图 debug/screenshots/quit_dry_nomenu.png）。
    // 「齿轮点了是不是同一个暂停菜单」**没验过**，所以退出链仍按用户定的顺序走
    // （卡牌菜单 → 设置 → 放弃此轮游戏），不抄这条近路。
    // ⚠️ roi **是为了躲开地图屏那枚齿轮**，2026-10-02 第一次跑退出链时撞出来的：
    // 卡牌菜单点下去之后面板要淡入，那几帧上面板还没盖住右上角，
    // 地图屏自己那枚齿轮 (1090,22,52x50) 先命中（0.7389），脚本照着**它的**位置
    // 点了一下 —— 点空，面板开了也没人点里面那枚，`wait_for(暂停菜单)` 超时。
    // 面板里这枚固定在 (1182,19,52x50)，地图上那枚在 1090，两者差得远：
    // roi 卡在 x≥1160 就只认面板里那枚，于是"面板开没开"自动变成了这道闸。
    // 量法：管线上不开 roi 时，面板帧上 `设置` 命中 (1182,19,52,50) score 1.000。
    "设置": {
        "recognition": "TemplateMatch",
        "template": "通用/btn_gear.png",
        "roi": [1160, 8, 120, 80],
        "action": "Click",
        "timeout": 20000
    },
    // 右上角人形十字图标：打开卡牌/祝福/护符/钥匙菜单面板。
    // 它同时是**局内退出这条链的第一步**（debug/quit_run.py、auto.quit_run）。
    //
    // 模板 2026-10-02 重剪：旧的那张 68x64 是**带背景、还放大了的松剪**
    // （图标只占中间 ~48px），对活屏最高只能到 0.505 —— 连阈值的边都摸不到，
    // 所以 `quit_run` 第一次跑就卡在「找不到卡牌菜单」。
    // 现在这张 56x56 取自活屏 1280x720 的事件屏（debug/screenshots/now_event.png
    // 的 (1181,28,56x56)，就是那枚人形十字本身），实测：
    //   地图屏 0.9170 @ (1180,25)（现场图 quit_dry_nomenu.png）
    //   事件屏 / 篝火现场帧 0.9997
    // ⚠️ **祭坛屏**上同一枚图标略小（量出来 ~50x50），最高只到 0.6697，
    // 卡在默认阈值 0.7 下面。退出链目前不会从祭坛屏发起（只有「没定过策略的
    // 事件」会触发它），撞上再说，别顺手放宽阈值 —— 那会把别的东西也放进来。
    "卡牌菜单": {
        "recognition": "TemplateMatch",
        "template": "通用/btn_menu.png",
        "action": "Click",
        "timeout": 20000
    },

    // 新到手的卡牌展示屏底部的提示「点击空白处继续」，点一下收掉。
    // 实测 (564,669,151x25)，score 1.000。2026-10-01 事件「困兽或囚徒」
    // 选「“询问他详情”」拿到一张「虚空奇点」时第一次见到。
    //
    // 这一屏**没有别的出口**（就是给你看一张刚入手的卡），所以它是唯一的出路。
    // 点的是提示**上方一点的空白处**（target_offset 把点从文字中心上移 30px，
    // 落到卡片下缘与提示之间那条空带里）——提示写的是"点击空白处"，就照它说的点。
    "点击空白处继续": {
        "recognition": "OCR",
        "expected": "点击空白处继续",
        "roi": [500, 655, 280, 55],
        "action": "Click",
        "target_offset": [0, -30, 0, 0]
    }
}
