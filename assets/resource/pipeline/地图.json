{
    // ============ 地图（路线图）界面 ============
    // 在地点里点「离开地点」后回到这里，选下一个去处。
    //
    // 每局随机生成，节点数量与位置都不固定，已知的节点类型：
    //   起点 / 战斗 / 精英战斗 / 印记石 / 献祭锻造间 / 事件 / 祝福祭坛
    // 图标各不相同，但**只有下方的文字标签能靠 OCR 稳定拿到**，所以节点识别走 OCR。
    //
    // 只能走相邻节点（用户确认），可前往的节点由**从当前节点出发的蓝色箭头**指示。
    // 箭头本身是曲线不好认，但每根箭的末端在节点上方表现为一枚**白色下弯箭头**
    // （青色描边、白色实心、带呼吸动画），认它就等于认出了箭头指向的节点。
    //
    // 曾有个 `可前往战斗节点` 节点靠 OCR 匹配「遭遇一场战斗」判断可前往——
    // **那个判据是错的**，已经在 2026-10-01 删掉：存档图里三个可前往的战斗节点
    // 根本没有那行描述文字，而实测可前往的印记石写的是「·通过印记赋予卡牌额外效果」。
    // 描述行只在部分节点类型上出现，不能拿来判可前往。

    // 地图节点标签：整屏 OCR，**故意不设 expected**——节点数量与位置每局随机，
    // 写不死，交给脚本从 all_results 里按节点词典自己归类。
    //
    // roi 的沿革（现在**不裁**，理由见节点内的注释）：
    //   · 原本裁掉顶栏（神智条）与底栏（金币/生命），只留地图区 [0,58,1280,596]；
    //   · 2026-10-01 把下沿从 618 放到 654（高度 560 → 596）：节点标签会**贴着
    //     地图区下沿**出现，实测「游艺」在 (1020,612,62,37)（y 612~649），
    //     旧下沿只让它露 6 像素进 roi，全屏 OCR 于是整条丢掉，脚本报"只有 1 个
    //     可前往节点"、用户看得见 2 个；
    //   · **2026-10-02 连这个 roi 一起去掉了** —— 裁切本身会让 OCR 丢字。
    "地图节点文字": {
        "recognition": "OCR",
        // **整屏，不裁。** roi 是给 OCR 限区提速用的，但在这屏**裁切本身会读坏字**：
        // 2026-10-02 同一帧上做对照（debug 临时脚本，逐条 roi 试），裁了之后
        // OCR 的检测框会把节点的**第一个字丢掉** ——
        //     roi [0,58,1280,596]（原值）：「首领」→「**领**」，「迷雾区」→「迷零区」0.842
        //     roi [0,58,1280,540]        ：「首领」对，但下沿 598 —— 底下的「迷雾区」整条没了
        //     roi [0,0,1280,720] / 不传 roi：「首领」1.000、「迷雾区」0.999、「黯淡篝火」1.000
        // 后果是实打实的：脚本把「首领」当成没定过的写法，停车等人（run_1002s.log:10）。
        // 而省下来的时间**可以忽略**：全屏 102ms、原 roi 85ms（各测 3 次，热身后），
        // 差 17ms —— 拿 17ms 换读错字不划算。
        //
        // ⚠️ **别把上面这段读成"裁切一律有害"**（2026-10-02 补）。有害的是
        // **照着大框裁**——上面那三种 roi 都是整条带/半屏，标签被切在框边上。
        // 围着**单个标签**开的小窗反而更准：「深入」整屏被读成「深）」（0.7345，
        // 检测框还窄了 8px），而标记正下方那一小条单独喂进去是「深入」**1.0000**。
        // 所以本节点不裁是正确的，`script/nav/map.py` 的 `_ocr_band` 单独裁一小条
        // 也是正确的——两者不矛盾。裁切读坏的是**边界**，不是裁切本身。
        //
        // 顶栏「神智 0/12」这类整屏才读得到的行不会变成假节点：标签要和标记做
        // **几何配对**（标记正下方那一小段）才算数，顶栏那行上方根本没有标记。
        "roi": [0, 0, 1280, 720],
        "action": "DoNothing"
    },

    // 可前往标记：节点上方那枚白色下弯箭头。
    //
    // **这枚箭头会闪烁**（用户指出）。实测周期约 0.6~0.7s、暗相约 0.36s，
    // 低谷能掉到 0.40 以下；而地形噪声稳定在 0.51~0.53 一动不动。
    // 也就是说**噪声比某些真标记的谷值还高，阈值根本分不开两者**：
    //    真标记(下印记石) 0.40↔0.84 振荡；真标记(上印记石) 峰值只有 0.65；
    //    噪声 (760,180)/(220,440)/(340,500)/(400,560) 连拍 20 帧纹丝不动。
    // 所以：
    //   1) threshold 定 0.58 卡在噪声与真标记之间（见下），别把闪烁低谷当成"没有标记"；
    //   2) 脚本侧连拍 6 帧、跨度 0.90s（> 一个周期）取并集，见 script/nav/map.py。
    // 扫三张存档图（配对成功数 / 期望值）：0.50 → 2/2、2/2、3/3；
    // 抬到 0.72 就变成 2/2、2/2、1/3。
    // **0.50 实测放过一枚 0.510 的地形噪声**（2026-10-01），配上下方一段被 OCR
    // 读成「6」的地形图标文字，地图凭空多出一个可前往节点——0.50 太松，已抬到 0.58：
    // 噪声稳定在 0.51~0.53，真标记多帧取并集后峰值 ≥0.65，正好卡中间。
    // 结论：**阈值与几何校验缺一不可**——阈值管粗筛，脚本里那道闸负责精筛：
    // 标记正下方 50~115px 内必须有标签、水平偏差 ≤20px，且那段文字得含汉字。
    // 另注意 all_results **不受 threshold 过滤**（0.4x 的结果也会返回），脚本侧要自己筛。
    //
    // ⚠️ **「噪声稳定在 0.51~0.53」这句 2026-10-02 被推翻了**，别再照它定阈值：
    // 那天脚本第 5 次报「等待选路」，多报的那枚是一条**静止灰地形斑**
    // (214,216,40,47)，连拍 10 帧分数**恒为 0.6010**（高过 0.58 这条线），
    // 而同一批帧里真箭头冲到 0.7610。也就是说**分数这一档噪声与真标记是重叠的**，
    // 靠挪 MARKER_MIN_SCORE 分不开（真箭头呼吸深谷里也落在 0.61 一带）。
    // 分开它们的是**亮度**：真箭头自发光，箭尖 p95G 峰值 251；假斑恒为 201
    // （存档帧上量到的同一类：真 247/248/252，假 ≤201）。所以修法是给**整枚**这条
    // 路补上和「箭尖」同一条亮度闸（见 script/nav/map.py 的 _marker_lit），
    // **不是**抬阈值。分数阈值仍是 0.58，没动。
    "可前往标记": {
        "recognition": "TemplateMatch",
        "template": "地图/map_marker.png",
        "method": 5,
        "threshold": [0.58],
        // roi 只管到 y 654：**和「地图节点文字」不再一致**（那个 2026-10-02 起改成整屏，
        // 因为裁切会读坏节点名；模板匹配没这个毛病，它的 roi 留着挡底栏噪声）。
        //
        // 顺带记一笔这枚箭头的脾气：它**跟着路径方向旋转**，朝右下那枚
        // （指向「游艺」的，实测 (1023,487)）分数在 **0.588~0.616** 之间跳，
        // 压着 0.58 这条线，因此时有时无——单帧常常只找到 2 枚里的一枚。
        // 试过把整帧转 ±30/45/60° 再匹配想救回它（debug/_rot_test.py），
        // **没用**：各角度最高也就 0.61，其余全是 0.5x 噪声。成因是"箭头朝 +
        // 身上压着一道白色拖影"，不是单纯旋转，转图解决不了。
        // 所以这边**别指望单帧**：脚本靠连拍取并集 + 青色路径线兜底。
        "roi": [0, 58, 1280, 596],
        "action": "DoNothing"
    },

    // 上面那枚箭头**被挡掉一截**时的补救：只认箭头下半截（那枚白色实心的
    // 「手/飞镖」形状），它比整枚小、被挡住的概率低。
    //
    // 2026-10-02 加。当天战场地图上「精英战斗」明明可以走，整枚标记却只有
    // 0.528（地形噪声水位），脚本第四次报「等待选路」停下等人。用户指出：
    // 「能走, 但是箭头被挡住了一部分」——箭头**在**，尾巴被「游艺」那个节点的
    // 黑色标签条压住了，只剩下面白花花的一截露在条子下方 (766,221)~(786,240)。
    //
    // 模板就是从 `地图/map_marker.png` 上裁下来的下半截：原图 (12,24) 起 24x23。
    // 因此**命中位置 + (12,24) 就是整枚箭头的左上角**——脚本侧靠这个偏移
    // 把两条路的结果并成同一个坐标系，见 script/nav/map.py 的 HEAD_DX/HEAD_DY。
    //
    // 为什么是 24x23 这么一块、为什么 method 5 且**不开 green_mask**：
    // 那是拿 6 种裁法 × method 5/10001/1 × 开不开掩码，在两张有真箭头的帧上
    // 量「真箭头位置的分 − 离它 30px 外的最高分」比出来的（debug/_frag_probe.py）。
    // 结论有点反直觉：**掩码反而更差**。
    //   - 掩码（亮像素留色、其余涂绿）只在 method 1/3 下能跑（cv::matchTemplate
    //     的 mask 限制），而这两个算法是**比亮度**不是比形状：被掩掉的正好是暗的
    //     地形、留下的全是 200+ 的亮像素，于是"整块都很亮"就够拿高分——白底
    //     界面通吃，194/225 张整屏图能上 0.90，一点分不开。
    //     method 5 + 掩码则退化到 0.53，比整枚还差。
    //   - 不开掩码的裸裁块 + method 5（均值相减，本来就抗光照）反而最好：
    //     两张真箭头帧上一个 0.790、一个 0.844，而整枚在同一帧只有 0.710 / 0.528。
    //
    // 这里的 threshold 只是**本节点的粗筛**，真正的两道闸在 script/nav/map.py 的
    // HEAD_MIN_SCORE / HEAD_MIN_LIT 那一段（那边遍历 all_results 自己筛，
    // all_results 不受这里的 threshold 过滤）。**两处要保持同一个数**：
    // 分数 0.68 + G 通道 95 分位 220，缺一不可——
    // （分位那条 2026-10-03 从 235 降到 220：当天撞上一枚天生就暗的箭头，
    //   30 帧最高只到 232，235 把整枚关在外面、脚本停车。取数与两侧余量
    //   见 script/nav/map.py 里 HEAD_MIN_SCORE 那一段的补记。）
    //   暗色同形物（分数能到 0.727，跟真箭头一样高）靠亮度拦；
    //   亮色冒牌货（云、毛皮高光，p95 能到 255）靠分数拦。
    //
    // **0.78 那版是错的，2026-10-02 当天改了**：当初按"亮色冒牌货的上沿"定的，
    // 依据是"0.75 时 map_goto_fail 那片云会造出一个叫「业」的可前往节点"。
    // 这条证据今天复现不出来（那张图上 p95G≥180 的箭尖命中只有两枚真箭头，
    // 其余全 ≤0.571），而 0.78 把真箭头的**呼吸平台**（常常只到 0.70~0.79）
    // 一整段切掉了：连读 3 次漏 1 次，脚本停车等人。
    // 取数、余量、以及"余量其实不宽"的实话，都在 map.py 那段注释里。
    //
    // 它是**只做加法**的补漏：整枚找得到的，它一个字都不会改（见 _merge_markers）。
    //
    // 复现用的两个家伙（都在 debug/ 下，只读不点）：
    //   debug/_frag_probe.py   裁法 × method × 掩码的对照表（当初选模板就用它）
    //   debug/_map_compare.py  同一批地图帧"开/关箭尖"读两遍，逐帧列出多出/丢了谁
    // 眼见为实的几张：debug/screenshots/_frag_contact.png（真箭头裁出来长什么样）、
    // _q_ctx_now_back_on_map.png / _q_ctx_map_goto_fail.png（箭尖命中的真箭头现场）。
    // 另有一张 _crop_ye.png 记着当初那片"云"——它现在复现不出来，留档而已；
    // _q_ctx_map_arrived.png 是"最强亮色冒牌货"的现场（战斗过场上的毛皮高光，
    // 0.668 / p95=255，距 0.68 只差 0.012）。
    //
    // ⚠️ **2026-10-03 又见一枚，而且是在地图屏上**：battle_end.png 里「深入」那个
    // 节点的图标光晕 + 它右边那个「⚔x1」徽标，这一路给出 0.61~0.690；30 帧里有
    // 8 帧够到 0.68 的线（亮度闸也过），归并成标记 (893,285,40,28)——**同一帧上
    // 真标记（箭尾那路，0.72~0.81）在 (862,201)**。它把节点名正下方那行小字
    // 配成了一个假节点，脚本于是停在「等待选路」（run_1003b.log 11:37）。
    // 那次的修法是**别让描述行当节点**（见 script/nav/map.py 的 DESC_ROW_DY），
    // 没动这里的线 —— 但记一笔：0.68 是贴着冒牌货定的（0.668 与 0.690 两头夹着），
    // 谁要动它，先把这两处现场都跑一遍。
    "可前往箭尖": {
        "recognition": "TemplateMatch",
        "template": "地图/map_marker_head.png",
        "method": 5,
        "threshold": [0.68],
        "roi": [0, 58, 1280, 596],
        "action": "DoNothing"
    },

    // 「箭尖」治的是**尾巴**被标签条压住；这一枚治**正相反**的那一种：
    // **箭尖那一截扎进了节点图标的光晕里**，尾巴（弯的那一段）反倒露在外面。
    //
    // 2026-10-03 加。现场 debug/screenshots/battle_map.png —— 脚本第 N 次停在
    // 「等待选路」，地图上「强大精英守卫」明明可以走（青色路径线指着它）。
    // 同一帧上逐块量过（python debug/_arrow_probe.py parts）：
    //     整枚 40x47     0.580   ← 压着 0.58 那条线，连拍十帧只有 ~2 帧够得着
    //     尾   40x28     0.748   ← 就是这一块
    //     尾   40x24     0.726
    //     尾   40x20     0.738
    //     尾   24x20(紧) 0.657   ← 只取弯钩那一小段反而更低
    //     箭尖 24x23     0.546   ← 被光晕吃掉，比同帧别处的噪声 0.553 还低
    // 也就是说：**被吃掉的那半截不但没分，还成了负资产**——整枚吃它一记拖累，
    // 箭尖那条路又恰好卡在被挡的那一块上，两边都不认。
    // 正常帧（op/11_see.png）上同一批裁块：整枚 0.868、尾 40x28 0.853 —— 两帧都认得出。
    //
    // 单帧的数字还不是定论，于是同一屏又连拍 **45 帧（8.10s）**逐帧按各自判据算：
    //     整枚：**0/45 帧过关**（8 秒里一次都没够着 0.58）；
    //     箭尾：**12/45 帧过关**（0.709~0.786，G 全 253），最长连续暗段 1.44s。
    // 于是这一条**不是锦上添花**：没有箭尾，这一屏永远读出「0 枚标记」→ 停车等人。
    // （暗段长度与 MARKER_FRAMES 够不够的关系，记在 script/nav/map.py 那一段。）
    //
    // threshold 定 0.68 的取数：真尾巴在被光晕吃掉那一帧仍有 0.748（下距 0.068）；
    // 另一侧，**亮度闸放得过去**的最高冒牌货是上面那条 0.553（上距 0.127）。
    // 取 0.68 与「箭尖」同数，两路对称，也好记。
    //
    // ⚠️ 与「箭尖」一样，这里的 threshold 只是**本节点的粗筛**：真正的两道闸在
    // script/nav/map.py 的 TAIL_MIN_SCORE 那一段（那边遍历 all_results 自己筛，
    // all_results 不受这里过滤）。**两处要保持同一个数。**
    //
    // 亮度闸量的是**尾巴这一块本身**（命中的那个框），不是箭尖 —— 这一路的前提
    // 恰恰是"箭尖看不清"，拿看不清的那块当判据，等于拿已知不可靠的东西当证据。
    //
    // 同样是**只做加法**的补漏：整枚/箭尖已经认出来的位置，它一个字都不会改。
    // 复现用：python debug/_arrow_probe.py parts（只识别、不点击）
    "可前往箭尾": {
        "recognition": "TemplateMatch",
        "template": "地图/map_marker_tail.png",
        "method": 5,
        "threshold": [0.68],
        "roi": [0, 58, 1280, 596],
        "action": "DoNothing"
    },

    // 地图界面锚点：左上角的神智条「神智 0/12」。
    // 地点界面也有「神智」字样（神智预算），所以用 roi 限定在左上角，别去掉；
    // 更可靠的是节点名「起点」，但那只在起点附近，走到后面就没了
    "地图界面": {
        "recognition": "OCR",
        "expected": "神智",
        "roi": [440, 25, 190, 45],
        "action": "DoNothing"
    }
}
