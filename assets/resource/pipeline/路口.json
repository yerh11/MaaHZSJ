{
    // ============ 路口（下一层的分岔选择）============
    // 从地图节点「深入」（那团黑色漩涡）过去后进入。左上标题「路口」，
    // 正文「数条道路在你的眼前展开，它们大相径庭，显然通往不同区域。
    // 看来该做出了选择，你要走哪边？」，左边竖排两三个选项，各带一行说明：
    //     第二层→第三层（2026-10-01）：「“前往白树高塔-秘密通道”」
    //                                  「“前往逆生白树-白树树根”」
    //     更早那层是：                「前往 古王国遗迹-印记石厅」
    //                                  「前往 黑龙祭祀场-祭祀长廊」
    //
    // **目的地每层都不一样**，所以最早那两个把目的地名写进 expected 的节点
    // （前往-古王国遗迹 / 前往-黑龙祭祀场）根本不通用——第三层这两个它一个都认不出，
    // 脚本在那儿空转了 15 轮才停车。现在改成**只放一个"取字"探针**，
    // 由 script/nav/fork.py 拿回全部选项、按目的地名做子串匹配。
    //
    // **这一屏没有「离开地点」**——它不是地点界面，是必须做的选择，
    // 所以别指望通用的「离开地点」分支能兜住它，脚本在这里只能选边。
    // 选边会把整层楼的走向定死，所以这里是"取字回来交给脚本判"，而不是"命中即点"。
    "路口界面": {
        "recognition": "OCR",
        "expected": "路口",
        "roi": [50, 50, 130, 70],
        "action": "DoNothing"
    },
    // 选项区。选项小标题同样套着**全角引号**（和事件屏是同一套控件），
    // 所以脚本按「以“开头的行」把选项单挑出来，再按 y 排序定第几个。
    // 实测标题 y=370 / 463，各自下面紧跟一行说明。
    // roi 下缘留到 560：够容下三个选项，又不碰 y>650 那条底部状态栏
    // （那里有金币/魂晶/生命，OCR 会把数字一起读进来，混进选项列表里）。
    // 宽度只到 430——选项标题最长 224px，够用；说明行本来就长过界，
    // 读残了也无所谓，反正它们不以引号开头、会被脚本丢掉。
    "路口选项行": {
        "recognition": "OCR",
        "roi": [110, 350, 320, 210],
        "action": "DoNothing"
    }
}
