{
    // ============ 深境结算（仪式失败 / 仪式成功）============
    // 放弃本轮或战斗结束时出现。左侧统计与结算，右侧卡牌/祝福/护符清单。
    //
    // **回主界面不是"点一下继续"就完了**（2026-10-01 打完首领通关那局实测）：
    //     本屏 →「继续」→ 星空过场 →「结束此次探索」
    //     →「获得物品」×2（排队弹，出口都是「点击任意空白处关闭」）
    //     → 星空过场**又回来了** →「结束此次探索」**再点一次**
    //     → 加载屏（几秒）→ 主界面
    // 「结束此次探索」要点两次、弹窗个数还不固定（梦境等级没升就少一个），
    // 所以收尾**没写死步数**——script/system/settlement.py 的 `finish_run()` 把这条路上的
    // 三屏当状态机轮着点，直到「主界面」出现。要改收尾逻辑改那里，别在这儿数步数。
    "仪式结算": {
        "recognition": "OCR",
        "expected": "统计数据",
        "action": "DoNothing",
        "next": []
    },
    // 结算屏左上角那行**标题 —— 胜负就写在上面**（用户 2026-10-03：
    // 「当屏幕上显示"仪式终结?"时,表示成功通关」）。两个节点同一个 roi、
    // 只差 expected，谁命中算谁；走法见 script/system/settlement.py 的
    // read_outcome()（**两个都没命中 = 没读出来，不报胜负**，不拿"没读到成功"
    // 当失败）。
    //
    // 实测（MaaFW 日志里同一位置来回读到的两种，都是存档里的真结果）：
    //     成功 → 「仪式终结?」 框 184,51,198x50 / 182,51,200x50
    //     失败 → 「仪式失败」   框 180,46,184x58 / 182,50,180x51
    // 两串都从 x≈180 起、y 46~104，roi 取 [160,30,260,90] 全罩住（截图核对：
    // debug/screenshots/_crop_title_probe.png，那张是通关那局的结算屏）。
    //
    // expected 只写「仪式终结」四个字、不带那个 '?'：`expected` 是**子串**匹配，
    // 而那一帧 OCR 读到的是**半角** '?'（日志原样 "仪式终结?"）—— 带上它反而
    // 可能读不出来。它也不会和「至使命终结为止」那种卡牌描述串：那串里没有
    // 「仪式」，且不在这个 roi 里。
    "仪式成功": {
        "recognition": "OCR",
        "expected": "仪式终结",
        "roi": [160, 30, 260, 90],
        "action": "DoNothing"
    },
    "仪式失败": {
        "recognition": "OCR",
        "expected": "仪式失败",
        "roi": [160, 30, 260, 90],
        "action": "DoNothing"
    },
    // 结算面板右下角的「继续」→ 关闭面板
    "继续": {
        "recognition": "OCR",
        "expected": "继续",
        "roi": [1020, 40, 260, 60],
        "action": "Click",
        "timeout": 20000
    },
    // 面板关闭后的星空过场画面，右上角「结束此次探索」→ 返回仪式配置
    "结束此次探索": {
        "recognition": "OCR",
        "expected": "结束此次探索",
        "action": "Click",
        "timeout": 20000
    },
    // 「结束此次探索」之后**会排队弹若干个**这种窗（实测两个：梦境等级升级奖励
    // 290→291 发 1250 经验券 + 3 个宝石，以及整局结算的 4 个材料）。
    // 标题都是「获得物品」，出口都是底部「点击任意空白处关闭」。
    // **个数不固定，别去数**——battle.finish_run() 是循环点掉直到不再出现。
    // 注意它是**模态**：盖着的时候底下「结束此次探索」就算认得出也点不动，
    // 所以 finish_run() 里「获得物品」必须排在「结束此次探索」前面。
    "获得物品": {
        "recognition": "OCR",
        "expected": "获得物品",
        "roi": [520, 40, 240, 60],
        "action": "DoNothing"
    },
    // 出口。点的是提示文字自己那行——它周围就是一片纯背景，
    // 照它写的「任意空白处」办即可（实测提示在 (530,671,219x30)）。
    "点击任意空白处关闭": {
        "recognition": "OCR",
        "expected": "点击任意空白处关闭",
        "roi": [500, 650, 280, 60],
        "action": "Click"
    }
}
