    // ---------- 「黑市行医」的弃牌框（2026-10-03 第一次见） ----------
    // 用户 2026-10-03 定的策略（原话）：
    //   「对于这个敌人, 需要特殊处理, 当选择时, 需要选择最后一张(最右)卡牌丢弃」。
    //
    // 现场（庸医事件选「坚定拒绝」触发的那一场，对手「黑市行医 等级: 6」37/199）：
    // 屏幕中央一行字「丢弃队列中1张牌换取6点虚质生命。」，下面一枚「确定」，
    // 再下面整排手牌。存图 debug/screenshots/fight_timeout.png。
    //
    // 和其它几个框一样是**模态**：弹出时右侧上下两枚「结束回合」整个不见，
    // fight() 里三个结局判据也一个都配不上 —— 不处理就是一路空点「自动出牌」
    // 到 300s 上限（实测 2026-10-03 空点到第 147 回合、存图后停车等人）。
    //
    // 判据用提示语本身：它是这一框唯一固定的一行字（下面那排牌每局都不一样）。
    "弃牌提示": {
        "recognition": "OCR",
        "expected": "丢弃队列中1张牌换取6点虚质生命",
        // 实测文字框 (483,376)-(793,393)。roi 左起 460、右到 820 留足；
        // **下沿停在 406** —— 再往下 425 起就是那枚「确定」按钮，留宽了
        // 会把按钮上的字一起读进来。
        "roi": [460, 364, 360, 42],
        "action": "DoNothing"
    },
    // 框里那枚「确定」。**和 `同化确定` 是同一个按钮、同一个位置**
    // （同化那次实测 (622,430,48x25) 中心 (646,442)；这一次实测
    // (628,432)-(670,448) 中心 (649,440)），所以 roi 照抄它。
    // 仍然**单开一个节点、不共用一个**：两者哪天各自挪了位，改一个不会误伤另一个。
    "弃牌确定": {
        "recognition": "OCR",
        "expected": "确定",
        // 下沿 460：再往下 505 起就是手牌的顶边
        "roi": [560, 424, 165, 36],
        "action": "Click"
    },
    // 「最右那张牌」的定位器。**不认牌面、不认数字，认的是每张牌左上角那枚
    // 费用徽章**（蓝色菱形底 + 白数字，实测宽 41 高 40，位置就在牌左上角，
    // 徽章左沿≈牌左沿）。
    //
    // 为什么不用模板：徽章里的数字每张牌都不同（实测同一手 0/2/4 三种），
    // 刻一个数字的模板去配别的数字，分掉到 0.60（实测），而且**有的牌压根
    // 不画徽章**（这一手第 2 张盾牌牌就没有，见 debug/screenshots/_zoom_dim.png），
    // 所以"数徽章个数 = 数牌数"是错的。这里只要**最右那一枚**，够用。
    //
    // 颜色是量的：徽章菱形底色实测 (0,80,128)（R,G,B），描边深一档 (0,32,80)，
    // 牌面紫色 (120,77,133) 的 R=120 被挡在 R<=80 之外，所以这一条只吃徽章。
    // method 4 = cv2 的 COLOR_BGR2RGB，通道序 **R,G,B**（同 `死亡黑屏`）。
    // roi 是**徽章那一条横带**（实测徽章 y 505~545）：往下一进到卡面美术
    // （蓝球、蓝盾那些也发蓝）就会混进假框，所以定死在这 48px 里。
    //
    // connected + count=50：只要连成一片、够 50 个像素的团。**脚本侧还会再筛一遍**
    // （宽≥20 且高≥15），因为实测 all_results 里还夹着一堆 1x1 的噪点。
    // order_by/index 只是让 best_result 也指向最右那一枚，取框的是 auto.discard_card()。
    "弃牌选牌": {
        "recognition": "ColorMatch",
        "lower": [0, 0, 95],
        "upper": [80, 255, 255],
        "method": 4,
        "connected": true,
        "count": 50,
        "order_by": "Horizontal",
        "index": -1,
        "roi": [140, 500, 1020, 48],
        "action": "DoNothing"
    },

