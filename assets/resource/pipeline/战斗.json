    // 用户 2026-10-02 原话（三句，一起看）：
    //     「点完「最后的机会」的「挣扎」后，又死亡了, 所以屏幕黑了, 此时要点击一下屏幕」
    //     「死亡画面不固定」「下一次死亡不一定时这个画面」
    //
    // 现场：点掉「挣扎」之后 Unity 跑了 DirectDeathCor / DeathDropCor（adb logcat
    // 17:28:39~42），随后整屏变黑，只剩右下角版本水印 PID619402 1.1.1.5，**停了
    // 13 分钟没变**，脚本在 fight() 里空等到 300s 超时停车
    // （存图 debug/screenshots/fight_timeout.png：黑底一大团紫色水晶）。
    //
    // **判据只能是"屏幕黑没黑"，不许认那团水晶** —— 用户当天明确"死亡画面不固定"，
    // 拿那张水晶当模板，下一次死亡换个画面就整条认不出来。
    //
    // 0.60 这条线是量出来的（debug/screenshots/_dead/ 连拍 60 帧，1 秒一张；
    // 量尺脚本 debug/_crystal_probe.py）：
    //     这一屏          整屏 max(R,G,B)<=25 的像素占 0.649 ~ 0.673
    //     纯黑帧          0.999（存档 gone_1.png / gaze_left.png，同一类黑屏）
    //     其它最黑的      0.532（游艺 arcade_spin2/3），再往下 <= 0.45
    // 0.60 × 1280×720 = 552960，取 550000（约 0.5968）：水晶屏过得去，非死亡帧差得远。
    "死亡黑屏": {
        "recognition": "ColorMatch",
        "method": 4,                    // cv2 的 COLOR_BGR2RGB，通道序 R,G,B
        "lower": [0, 0, 0],
        "upper": [25, 25, 25],
        "count": 550000,
        "roi": [0, 0, 0, 0],            // 全屏
        "action": "DoNothing"
    },
    // 「点一下屏幕」：点的是**屏幕正中** (640,360)。
    // 黑屏上没有按钮也没有字，用户说的就是"点击一下屏幕"，所以写死正中。
    // **不拿识别的 box 当点击依据**：ColorMatch 的 box 是"黑像素的包围盒"，
    // 画面一变它就跟着变，点哪就不好说了。
    "死亡黑屏继续": {
        "recognition": "ColorMatch",
        "method": 4,
        "lower": [0, 0, 0],
        "upper": [25, 25, 25],
        "count": 550000,
        "roi": [0, 0, 0, 0],
        "target": [640, 360],
        "action": "Click"
    },

    // 整屏 OCR，**不为认某一屏** —— 只用来回答"这一屏上有没有字"。
    //
    // 唯一的使用者是 `script/combat/death.py` 的死亡判据（第二道闸）。
    // 用户 2026-10-02 给的：「**死亡黑屏是没有任何文字的**」。
    // 这一道是为了把它和**暗事件屏**分开：两者都黑得够呛，只认"黑"会认错 ——
    // 2026-10-02 就停在那儿了（整帧平均亮度 23.7、亮度<60 的像素占 0.9178，
    // 而屏上明明有标题「困兽或囚徒」和两个选项，整屏 OCR 15 行），
    // 脚本对着插图正中连点了十来下（存图 debug/screenshots/_park_1002ai.png、
    // 日志 debug/run_1002ai.log）。
    //
    // **为什么另开一个节点、不共用 地图节点文字**：两者现在的参数看着一样
    // （都是整屏、不裁、无 expected），但那个的 roi 是**为地图标签**调的
    // （它自己那段长注释解释得很清楚），哪天为地图把它收紧一点，
    // 这里就会跟着坏，而且是静默地坏。宁可多一个节点。
    "屏幕文字": {
        "recognition": "OCR",
        "roi": [0, 0, 1280, 720],
        "action": "DoNothing"
    },

    // ---------- 死透之后的「化形信使」（2026-10-02 第一次见） ----------
    // 用户 2026-10-02 定的策略：**点「不留下遗物」**。
    // 原话是问「死亡后这一屏…脚本该点哪个？」，答"不留下遗物"（左边那枚）。
    //
    // 现场：上面那个黑屏点一下之后进来的就是这一屏 —— 顶部标题「化形信使」，
    // 中间一句话「你要，留下，些什么」，底部并排两个按钮，实测左「不留下遗物」
    // (475,597)、右「留下遗物」(809,597)。存图 debug/screenshots/_death_relic.png，
    // 那一次脚本报「未知界面」停车（debug/run_1002af.log）。
    //
    // **判据用标题「化形信使」**：它是这一屏的抬头；两个按钮是选项、不是判据
    // （同「夜巡人选项」那一框的道理 —— 选项文案会不会变没验过，拿它当判据，
    // 下次换句话就整条认不出来）。
    "化形信使": {
        "recognition": "OCR",
        "expected": "化形信使",
        // 实测标题框 (577,37,127x37)，上下左右各留余量
        "roi": [520, 20, 240, 70],
        "action": "DoNothing"
    },
    // 「不留下遗物」（左边那枚）。**roi 只留左边**：右边那枚「留下遗物」
    // 实测框 (758,579,103x33) 整条落在 roi 外面，不会点错那一个。
    "不留下遗物": {
        "recognition": "OCR",
        "expected": "不留下遗物",
        // 实测框 (412,579,126x32)，四周留余量；右边界 570 离右按钮的左沿 758 还远
        "roi": [370, 555, 200, 60],
        "action": "Click"
    },

    // ---------- 战斗结束 ----------
    // 胜利：中央横幅「战斗胜利」，下方是奖励二选一
    // **但「打穿首领」不走这里**：2026-10-01 通关那场（护封骑士-帕特拉姆，
    // 噩梦9层第36层，42 回合）全程没出现过这行横幅，也没经过奖励界面，
    // 打完直接切到总览屏「统计数据」（结算.json 的 `仪式结算`）。
    // 所以这个节点只认**普通战/精英战**的胜利，别当成本局收尾的必经判据——
    // 那一屏还同时是**失败**的收尾（结算.json 头部注释：仪式失败 / 仪式成功）。
    "战斗胜利": {
        "recognition": "OCR",
        "expected": "战斗胜利",
        "roi": [540, 125, 200, 55],
        "action": "DoNothing"
    },
    // 打不过就跑：精英／持久战会转成**「逃离战斗」**结算（实测敌人
    // 「侵蚀-迷狂演变」打到第 7 回合转的）。它**不是胜利也不是失败**，
    // 是第三种结局——下面「战斗胜利」那个锚点认不出它，
    // 所以 fight() 必须单独认这一个，否则会一直等按钮、空转到超时。
    // 实测标题 (569,131,139x37)，和「战斗胜利」几乎同一个位置。
    "逃离战斗": {
        "recognition": "OCR",
        "expected": "逃离战斗",
        "roi": [540, 120, 210, 60],
        "action": "DoNothing"
    },
    // 奖励二选一：左边「卡牌」→ 选择（进选牌界面）；
    // 右边「战利品」→ 获取（直接拿走，金币/魂晶似乎两个都会自动结算）
    "选择奖励卡牌": {
        "recognition": "OCR",
        "expected": "选择",
        "roi": [480, 430, 150, 45],
        "action": "Click"
    },
    "获取战利品": {
        "recognition": "OCR",
        "expected": "获取",
        "roi": [660, 430, 150, 45],
        "action": "Click"
    },

    // 卡牌详情面板：单击手牌弹出，含牌名和效果描述（如「葬撞头槌+」）。
    // 打出卡牌是拖拽手牌到目标身上，不是点击
    "卡牌详情": {
        "recognition": "OCR",
        "expected": "攻击牌",
        "roi": [230, 45, 200, 40],
        "action": "DoNothing"
    }
}
