{
    // ============ 启动游戏 ============
    // 任务入口：拉起游戏，等待标题界面出现
    "启动游戏": {
        "action": "StartApp",
        "package": "com.chillyroom.containerofsoul.yw",
        // 冷启动到标题界面实测约 40~60s，故放宽 timeout（默认 20000ms 不够）
        "timeout": 120000,
        // 必须同时列出两种起点的可能：
        //   - 游戏未运行 → 冷启动，先到标题界面
        //   - 游戏已在运行 → StartApp 仅切到前台，直接就是主界面/弹窗
        // 只写「标题界面」会导致后者空等到超时，任务直接结束
        "next": [
            "标题界面",
            "公告界面",
            "关闭评价弹窗",
            "主界面"
        ]
    },
    // 标题界面：识别到「点击任意处开始」即点击进入。
    // 用 OCR 而非模板匹配，因为该文字清晰、对比度高，
    // 且不依赖标题背景（极光为动态图，模板匹配易受干扰）
    "标题界面": {
        "recognition": "OCR",
        "expected": "点击任意处开始",
        "action": "Click", // target 缺省即点击识别结果框中心
        // 点击后需经历登录与地图加载（实测约 25s），
        // 期间两个后继节点均不命中，故 timeout 需覆盖整段加载
        "timeout": 60000,
        // 点进之后路上挡着的东西依次列出：公告页（热更后首次启动）、评价弹窗，
        // 都没有才直接命中主界面。顺序即优先级，故遮挡物必须排在「主界面」前面
        "next": [
            "公告界面",
            "关闭评价弹窗",
            "主界面"
        ]
    },
    // 每日首次启动会弹出「评价邀请」弹窗，遮挡主界面，需先关闭。
    // 模板为弹窗右上角红色 X，位置固定，用模板匹配比 OCR 认 "X" 可靠
    "关闭评价弹窗": {
        "recognition": "TemplateMatch",
        "template": "启动/popup_close.png",
        "action": "Click",
        "timeout": 20000,
        "next": [
            "主界面"
        ]
    },
    // 每日签到面板：2026-10-05 08:11 第一次撞上 —— 一整局打完、点完「结束此次探索」
    // 的过场之后它盖在主界面上（底下就是主界面，被它挡得一个字认不出），
    // `settlement.finish_run` 空等 300s 超时停车（debug/screenshots/loop_notmain.png）。
    //
    // 出口用户 2026-10-05 定：**点右上角那枚蓝色 X 关掉，不领**（照「评价弹窗」那枚
    // X 的先例）。⚠️ 它**不是**模板匹配：那枚 X 是量出来的**固定坐标**，见
    // `core/auto.py` 的 `DAILY_X`；本节点只负责认「这一屏在不在」。
    //
    // 只认标题那一条带子、并用 ^$ 锚定：右边「月卡奖励」栏里另有一行
    // 「每日签到时额外获得」（实测 (958,197,135,17)，**以这四个字开头**，
    // 不锚定 + roi 放开就会误命中）。roi 只圈标题字本身 (226,66,102,29) 那一带。
    "每日签到": {
        "recognition": "OCR",
        "expected": ["^每日签到$"],
        "roi": [150, 40, 350, 80],
        "action": "DoNothing",
        "next": []
    },
    // 网络错误对话框：2026-10-14 16:09 第一次撞上 —— 一整局打完、点完「结束此次探索」
    // 之后的那张加载屏上弹出来（现场帧 debug/screenshots/finish_run_stuck.png）：
    // 居中一块面板，上「网络错误」、中「错误代码：10001」、底下一左一右两枚按钮
    // 「关闭」「重试」。`settlement.finish_run` 从前认不出它 ⇒ 对着它空等满 300s 停车
    // （`[16:14:51] 300s 内没回到主界面`）。
    //
    // 出口定的是**「重试」**（2026-10-14 定）：这一屏是一次**服务端往返**失败了
    // （收尾落盘），游戏自己给的补救就是「重试」；按「关闭」多半丢下这一步、
    // 退到标题界面，脚本还得再绕一次主界面 —— 与「让脚本连续跑下去」相悖。
    // ⚠️ **这两个节点都只负责认**（DoNothing），点法是各调用点的事（`guard` 用
    // 「网络错误」＝面板还在才点），与「每日签到」那对节点同款。
    //
    // 「网络错误」只圈标题那一条带子：底下「错误代码：10001」实测 (565,390,148,22)，
    // 不圈开会在那一行上蹭到。^$ 锚定，免得圈进别的字样。
    "网络错误": {
        "recognition": "OCR",
        "expected": ["^网络错误$"],
        "roi": [520, 300, 240, 60],
        "action": "DoNothing",
        "next": []
    },
    // 面板底下**右边**那枚「重试」。roi 从 x=700 起，把左边那枚「关闭」
    // （实测 (464,463,46,30)）整个让出去 —— 两个词都只有两个字，圈宽了
    // 就会把「关闭」也当候选。
    "网络错误重试": {
        "recognition": "OCR",
        "expected": ["^重试$"],
        "roi": [700, 445, 220, 60],
        "action": "DoNothing",
        "next": []
    },
    // 公告页：热更之后首次冷启动会自动弹出来，**整屏盖住主界面**
    // （2026-10-02 撞上，游戏 1.1.1.5 的「热更公告」，内容写「修复了探寻页面配置错误的问题」）。
    // 不点掉它，下面「主界面」永远等不到 —— 原来就是这么卡在开局的。
    // 出口只有一个：左上角那支返回箭头，和锻造子界面的返回**是同一个图标**，
    // 所以直接复用「返回」节点（实测在这屏上命中 (79,22,56,50)）。
    //
    // 只认标题栏里那两个字，并用 ^$ 锚定：列表项里还有「热更公告」「更新公告」，
    // 不锚定的话它们也会算命中。roi 从 x=140 起，把返回箭头让出去。
    "公告界面": {
        "recognition": "OCR",
        "expected": ["^公告$"],
        "roi": [140, 5, 180, 70],
        "action": "DoNothing",
        "next": [
            "返回"
        ]
    },
    // 主界面：以右侧菜单「观星室」为特征锚点。
    // 该词为固定菜单项、OCR 置信度 0.999，且不会出现在其他界面
    "主界面": {
        "recognition": "OCR",
        "expected": "观星室",
        "action": "DoNothing", // 仅作状态判定，不执行操作
        "next": []
    }
}
