{
    // ============ 锻造使的「卡牌升变」子界面 ============
    // 外面那一屏（标题「锻造使」、两个选项）定义在 地点.json；
    // 这里只放点「形态升变」之后进来的这一屏。
    //
    // 界面：左边是返回箭头 + 详情面板，右边是卡牌网格（4 列，卡片中心 x 依次
    // 810/918/1026/1134，间距 108；行中心 y 183/365/545，间距 182）。
    // 点一张牌 → 左边出详情，底部浮出确认按钮；点确认才真扣金币并升变。
    //
    // **注意这是两段式**（和篝火的选项一样）：点卡只是选中，底部按钮才生效。

    // 整屏锚点。右上角标题「卡牌升变」——别用左边的「升变图鉴」，
    // 那两个字更短、更容易被 OCR 切碎
    "卡牌升变界面": {
        "recognition": "OCR",
        "expected": "卡牌升变",
        "roi": [920, 15, 150, 50],
        "action": "DoNothing"
    },

    // 网格里那把斧头卡（模板裁自 op/13.png 第二行第一列）。
    //
    // **卡名是「无畏斧」** —— 2026-10-01 拿 op/14.png 亲眼核过：那帧是「卡牌升变」
    // 的两段式对比屏，左边那把土黄斧头的名字栏写着「无畏斧+」，右边预览着要变过去的
    // 形态，中间挂「熔岩」标签，底下写「付出6金币升变为熔岩」。
    // 名字里的 `+` 是**等级标记不是名字的一部分**（那张卡带蓝色「1」角标；
    // 事件.json 那边的约定也是"同名卡可能有 + 后缀，比对时按去掉 + 的前缀认"），
    // 所以节点名取不带 + 的 **无畏斧**。
    //
    // 模板带的是**土黄原形态**，升变成「熔岩」之后卡面变橙就不再匹配了——
    // 这正好让"每次取最靠前的一把"天然跳过已经升过的。
    // （op/15、op/16 实测：升完第一把金币 25→19、第二把 19→13，每次 6 枚，卡面当场变橙。）
    // roi 圈住整个网格，别放到底部状态栏
    "卡牌-无畏斧": {
        "recognition": "TemplateMatch",
        "template": "锻造/无畏斧.png",
        "method": 5,
        "threshold": [0.85],
        "roi": [720, 85, 490, 530],
        "action": "Click"
    },

    // 选中卡后浮出的确认区。**按钮本身没有文字**（只有一个锤子图标和「-6」），
    // OCR 认不到，所以用上面那行提示文字定位，再靠 target_offset 落到按钮上：
    //     提示文字框实测 (288,528,204,18)，中心 (390,537)
    //     确认按钮实测中心 (400,610)
    //     差值 → 偏移 (10, 73)
    // 提示文字是**居中**排的，所以目标卡名长短变化时中心基本不动，偏移稳定。
    // roi 给得比实测宽，容纳不同长度的卡名。
    "升变确认": {
        "recognition": "OCR",
        "expected": "付出",
        "roi": [250, 515, 280, 42],
        "action": "Click",
        "target_offset": [10, 73, 0, 0]
    },

    // 左上角的返回箭头（模板裁自 op/13.png）。回到「锻造使」那一屏。
    // 只认图标不认文字——那个箭头没有文字。
    "返回": {
        "recognition": "TemplateMatch",
        "template": "锻造/btn_forge_back.png",
        "method": 5,
        "threshold": [0.85],
        "roi": [56, 14, 96, 70],
        "action": "Click"
    },

    // 底部状态栏的金币数量。升级一把要 6 金币，够不够得先读出来。
    // 位置同 地点.json 的「魂晶数量」，只是往左一格（魂晶在金币右边）。
    "金币数量": {
        "recognition": "OCR",
        "roi": [196, 674, 60, 36],
        "action": "DoNothing"
    }
}
